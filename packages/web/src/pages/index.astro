---
import Base from '../layouts/Base.astro';
import Leyenda from '../components/Leyenda.astro';
import TablaDemarcaciones from '../components/TablaDemarcaciones.astro';
import { resumen, nacional as N, NA, f, fechaDatos, fechaDiaMes, mesDe, rel, veredicto, clase, NOMBRES, porPct, ejemplos, estadoDe } from '../lib/datos';
import { zonas, alto } from '../lib/mapa';

const dif = N.dif_media_pts ?? 0;
const anios = resumen.anios;
const peores = anios.filter((a) => a.pct < N.pct).length;
const aMax = Math.max(...anios.map((a) => a.pct)), aMin = Math.min(...anios.map((a) => a.pct));
const tope = Math.max(aMax, N.pct);
const barras = [...anios.map((a) => ({ et: a.fecha.slice(0, 4), v: a.pct, hoy: false })), { et: 'hoy', v: N.pct, hoy: true }];
const grave = dif > 1 ? 'Por ahora, no' : dif < -1 ? 'Es motivo de atención' : 'No más de lo habitual';
const sube = N.var_pts === 0 ? 'Sin cambios.' : `${N.var_pts > 0 ? 'Sube.' : 'Baja.'} ${N.var_pts > 0 ? 'Suben' : 'Bajan'} ${f(Math.abs(N.var_pts))} puntos frente a la semana anterior (${f(N.pct_previa)} %).`;
const top = porPct[0], bot = porPct[porPct.length - 1];
const ej = ejemplos();
const frase = (p: number, m: number | null) => m == null ? 'Sin media comparable para esta época.' : p - m > 1 ? `Más lleno de lo habitual: ${f(p - m)} puntos por encima de su media.` : p - m < -1 ? `Más vacío de lo habitual: ${f(m - p)} puntos por debajo de su media.` : 'En su media.';
---
<Base title="Embalses de España: ¿hay agua?" description={`Los embalses peninsulares están al ${f(N.pct)} % de su capacidad (boletín del ${fechaDatos}). El estado de los embalses de España, contado como respuestas a las preguntas de siempre.`} pag="portada">
<main class="col ancha" id="main">
  <p class="fecha">Boletín del {fechaDatos}. Datos provisionales.</p>

  <section class="qa" aria-labelledby="q1">
    <h1 class="q" id="q1">¿hay agua?</h1>
    <div class="a">
      <p class="si">{veredicto(dif, N.pct)}</p>
      <p class="gigante" aria-hidden="true"><mark><span>{f(N.pct)}</span><small>%</small></mark></p>
      <p>Los embalses peninsulares guardan {f(N.hm3, 0)} hm³ de los {f(N.capacidad, 0)} hm³ que caben. Es el {f(N.pct)} % de su capacidad.</p>
      <p class="peq">La media de la misma semana en los {NA} años anteriores es {f(N.media10 ?? 0)} %: hoy estamos {f(Math.abs(dif))} puntos {rel(dif)} ella.</p>
    </div>
  </section>

  <section class="qa" aria-labelledby="q2">
    <h2 class="q" id="q2">¿es grave?</h2>
    <div class="a">
      <p class="si">{grave}.</p>
      <p>Esta semana, en {anios.length - peores} de los últimos {anios.length} años había más agua que ahora; en {peores}, menos. El mínimo fue {f(aMin)} % y el máximo {f(aMax)} %.</p>
      <ol class="anios" aria-label="Reserva peninsular en la misma semana de cada uno de los últimos años y ahora">
        {barras.map((b) => <li class={b.hoy ? 'hoy' : ''} aria-label={`${b.et}: ${f(b.v)} %`}><span class="v">{f(b.v, 0)}</span><span class="b" style={`height:${b.v / tope * 80}%`}></span></li>)}
      </ol>
      <ol class="anios-et" aria-hidden="true">{barras.map((b) => <li>{b.hoy ? 'hoy' : b.et.slice(2)}</li>)}</ol>
      <p class="peq">Una barra por año, misma semana de {mesDe(resumen.fecha)} ({anios.map((a) => a.fecha.slice(0, 4)).join(', ')}). La resaltada es esta semana. Cifras en %.</p>
    </div>
  </section>

  <section class="qa" aria-labelledby="q3">
    <h2 class="q" id="q3">¿sube o baja?</h2>
    <div class="a">
      <p class="si">{sube}</p>
      <p class="peq">Variación semanal de la reserva peninsular, en puntos de porcentaje, entre el {fechaDiaMes(resumen.fecha_previa)} y el {fechaDatos}.</p>
    </div>
  </section>

  <section class="qa" aria-labelledby="mapa-q">
    <h2 class="q" id="mapa-q">¿dónde hay más y dónde menos?</h2>
    <div class="mapa-w">
    <div class="a">
      <div class="dos">
        <p class="mas"><b>Más: {top.nombre}, {f(top.pct)} %</b><span>{f(top.hm3, 0)} hm³ de {f(top.capacidad, 0)} hm³{top.media10 != null && `; su media es ${f(top.media10)} %`}.</span></p>
        <p class="menos"><b>Menos: {bot.nombre}, {f(bot.pct)} %</b><span>{f(bot.hm3, 0)} hm³ de {f(bot.capacidad, 0)} hm³{bot.media10 != null && `; su media es ${f(bot.media10)} %`}.</span></p>
      </div>
    </div>
    <figure class="mapa">
      <svg viewBox={`0 0 1000 ${alto}`} role="img" aria-labelledby="mapa-q mapa-d">
        <desc id="mapa-d">Mapa de la España peninsular por demarcación hidrográfica, coloreado según el porcentaje de llenado, de casi seco a muy alto. Los valores exactos están en la tabla de debajo.</desc>
        {zonas.map((z) => <path class={z.r ? `c${clase(z.r.pct)}` : 'sin'} d={z.d}><title>{z.nombre}: {z.r ? `${f(z.r.pct)} %` : 'sin dato'}</title></path>)}
      </svg>
      <figcaption><Leyenda /></figcaption>
    </figure>
    </div>
    <div class="a">
      <details>
        <summary>Ver los datos en tabla</summary>
        <TablaDemarcaciones />
      </details>
      <p class="mas-mapa"><a href="/mapa">Abrir el mapa grande</a></p>
    </div>
  </section>

  <section class="qa" aria-labelledby="ej-q">
    <h2 class="q" id="ej-q">¿y mi embalse?</h2>
    <div class="a">
      <p>El boletín recoge <span class="cifra">{f(N.n_embalses, 0)}</span> embalses peninsulares. Tres para empezar:</p>
      <ol class="ej">
        {ej.map((x) => { const p = x.actual!.pct; const m = x.media10; return (
          <li><h3><a href={`/embalse/${x.e.slug}`}>{x.e.nombre}</a></h3><p class="peq">{[x.e.provincia, x.e.demarcacion, x.rol].filter(Boolean).join(' · ')}</p>
          <p class="frase"><mark class="cifra">{f(p)} %</mark> de <span class="cifra">{f(x.e.capacidad_hm3, 0)}</span> hm³. {frase(p, m)}</p>
          {m != null && <div class="mini" role="img" aria-label={`De 0 a 100 %: ahora ${f(p)} %, media ${f(m)} %`}><i style={`width:${p}%`}></i><u style={`left:${m}%`}></u></div>}
          {m != null && <p class="peq">Raya de la media: {x.nMedia} años, {f(m)} %.</p>}</li>
        ); })}
      </ol>
    </div>
  </section>
</main>
<style is:global>

.anios { margin: var(--s-5) 0 var(--s-2); padding: 0; list-style: none; display: grid; grid-template-columns: repeat(11, 1fr); gap: var(--s-1); align-items: end; height: calc(var(--s-12) * 4); border-bottom: var(--filete) solid var(--tinta); }
.anios li { display: flex; flex-direction: column; justify-content: flex-end; align-items: center; height: 100%; min-width: 0; }
.anios .b { width: 100%; background: var(--linea); border-top: var(--filete-grueso) solid var(--tinta-2); min-height: var(--filete); }
.anios .v { font: 600 var(--t-0)/1.1 var(--f-cifras); font-variant-numeric: tabular-nums; margin-bottom: var(--s-1); }
.anios li.hoy .b { background: var(--marca); border: var(--filete) solid var(--tinta); }
.anios-et { list-style: none; margin: 0 0 var(--s-4); padding: 0; display: grid; grid-template-columns: repeat(11, 1fr); gap: var(--s-1); font: 500 var(--t-0)/1.2 var(--f-cifras); text-align: center; color: var(--tinta-2); }
.anios-et li { overflow: hidden; }
.anios-et li:nth-child(even):not(:last-child) { visibility: hidden; }
.anios-et li:last-child { overflow: visible; white-space: nowrap; font-weight: 700; color: var(--tinta); }
.dos { display: grid; gap: var(--s-4); margin: 0 0 var(--s-2); }
.dos p { margin: 0; }
.dos b { display: block; font: var(--peso-titulo) var(--t-2)/1.2 var(--f-titulos); }
.dos .mas b { color: var(--rio); } .dos .menos b { color: var(--alerta); }
.ej { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-6); }
.ej li { padding-top: var(--s-3); border-top: var(--filete-fino) solid var(--tinta); }
.ej h3 { font: var(--peso-titulo) var(--t-3)/var(--lh-titulo) var(--f-titulos); letter-spacing: -.015em; margin: 0 0 var(--s-1); }
.ej h3 a { color: var(--tinta); }
.ej p { margin: 0 0 var(--s-2); }
.ej .frase { line-height: var(--lh-largo); }
.mas-mapa { margin-top: var(--s-3); }
@media (min-width: 48rem) { .dos { grid-template-columns: 1fr 1fr; } .anios { height: calc(var(--s-12) * 4.5); } }
@media (min-width: 64rem) {
  .mapa-w { display: grid; grid-template-columns: minmax(0, 1fr) 15rem; gap: 0 var(--s-8); align-items: start; }
  .mapa-w > .a { grid-column: 2; grid-row: 1; border-left: 0; padding-left: 0; }
  .mapa-w .mapa { display: contents; }
  .mapa-w .mapa svg { grid-column: 1; grid-row: 1 / span 2; max-height: none; margin-top: var(--s-5); }
  .mapa-w figcaption { grid-column: 2; grid-row: 2; }
  .mapa-w .leyenda { flex-direction: column; margin-top: 0; }
  .mapa-w .dos { grid-template-columns: 1fr; margin-top: var(--s-5); }
  .anios { height: calc(var(--s-12) * 5.5); gap: var(--s-2); }
  .anios-et { gap: var(--s-2); }
}
</style>
</Base>
