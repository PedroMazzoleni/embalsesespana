---
import Base from '../layouts/Base.astro';
import Leyenda from '../components/Leyenda.astro';
import TablaDemarcaciones from '../components/TablaDemarcaciones.astro';
import { nacional as N, NA, f, fechaDatos, rel, clase, NOMBRES, embalses, estadoDe } from '../lib/datos';
import { zonas, alto } from '../lib/mapa';

const dif = N.dif_media_pts ?? 0;
const frase = `Los embalses están al ${f(N.pct)} %, ${f(Math.abs(dif))} puntos ${rel(dif)} la media de los últimos ${NA} años.`;
const conCoord = embalses.filter((e) => e.lat != null).length;
const ejemplosDe = (cod: string) => embalses.filter((e) => e.demarcacion_codigo === cod && e.activo)
  .sort((a, b) => b.capacidad_hm3 - a.capacidad_hm3).slice(0, 3).map(estadoDe).filter((x) => x.actual);
---
<Base title="¿Dónde hay agua? Mapa de embalses por demarcación" description={`Mapa de la reserva de agua en cada una de las ${zonas.length} demarcaciones hidrográficas peninsulares (boletín del ${fechaDatos}), con tabla de datos.`} pag="mapa">
<main class="col ancha" id="main">
  <p class="fecha">Boletín del {fechaDatos}. Datos provisionales.</p>
  <section class="qa plena" aria-labelledby="q1">
    <h1 class="q" id="q1">¿dónde hay agua?</h1>
    <div class="a">
      <p class="si">{frase}</p>
      <p class="peq">Cada zona es una demarcación hidrográfica; el color dice cuánto de su capacidad está lleno. Elige una zona con el ratón, el dedo o el teclado (Tab y Enter) o usa las flechas para pasar de una a otra; Inicio y Fin van a la primera y a la última.</p>
    </div>

    <div class="lay">
      <figure class="mapa">
        <div id="mapa-caja" class="mapa-caja">
        <div id="mapa-svg"><svg id="mapa"viewBox={`0 0 1000 ${alto}`} role="radiogroup" aria-labelledby="q1 mapa-d">
          <desc id="mapa-d">Mapa de la España peninsular por demarcación hidrográfica, coloreado según el porcentaje de llenado. Cada zona se puede seleccionar. Los valores exactos están en la tabla de debajo.</desc>
          {zonas.map((z, i) => z.r && <path class={`c${clase(z.r.pct)}`} data-c={z.codigo} d={z.d} tabindex={i === 0 ? 0 : -1} role="radio" aria-checked="false" aria-label={`${z.nombre}: ${f(z.r.pct)} %, nivel ${NOMBRES[clase(z.r.pct)].toLowerCase()}`}></path>)}
          <g class="resalte"><path class="ext"></path><path class="int"></path></g>
        </svg></div>
        <div id="mapa-gl" class="mapa-gl" hidden tabindex="0" role="group" aria-label="Mapa interactivo con relieve. Flechas: cambiar de demarcación. Intro: abrir el detalle. Escape: cerrar."></div>
        <div id="mapa-ctl" class="mapa-ctl" hidden>
          <button type="button" id="mapa-plano" aria-pressed="false">Vista plana</button>
          <button type="button" id="mapa-cerrar" hidden>Cerrar detalle</button>
        </div>
        </div>
        <p id="mapa-aviso" class="solo-lector" aria-live="polite"></p>
        <figcaption><Leyenda />
        <p class="peq">{conCoord} de {embalses.length} embalses tienen coordenadas en la tabla maestra y aparecen como puntos en el mapa interactivo; esta versión estática solo muestra las demarcaciones.</p></figcaption>
      </figure>
      <aside class="panel" aria-label="Detalle de la demarcación elegida"><div id="panel" aria-live="polite">
        <div data-p=""><h2>Elige una demarcación</h2><p class="vacio">Aquí verás cuánta agua tiene, cómo está frente a su media y qué embalses grandes hay.</p></div>
        {zonas.map((z) => { if (!z.r) return null; const r = z.r, k = clase(r.pct), d = r.dif_media_pts ?? 0, ej = ejemplosDe(z.codigo); return (
          <div data-p={z.codigo} hidden>
            <h2>{z.nombre}</h2>
            <p class="nivel"><span class={`sw c${k}`}></span>{NOMBRES[k]}</p>
            <p class="gran"><mark>{f(r.pct)} %</mark></p>
            <p>{r.media10 == null ? 'Sin media comparable.' : d > 1 ? `${f(d)} puntos por encima de su media de ${NA} años.` : d < -1 ? `${f(-d)} puntos por debajo de su media de ${NA} años.` : `En su media de ${NA} años.`}</p>
            <dl><dt>Volumen</dt><dd class="cifra">{f(r.hm3, 0)} hm³</dd><dt>Capacidad</dt><dd class="cifra">{f(r.capacidad, 0)} hm³</dd>{r.media10 != null && <><dt>Media {NA} años</dt><dd class="cifra">{f(r.media10)} %</dd></>}<dt>Embalses</dt><dd class="cifra">{f(r.n_embalses, 0)}</dd></dl>
            {ej.length > 0 && <><p class="peq">Los mayores embalses de la zona:</p><ul>{ej.map((x) => <li><a href={`/embalse/${x.e.slug}`}>{x.e.nombre}</a>, <span class="cifra">{f(x.actual!.pct)} %</span></li>)}</ul></>}
          </div>
        ); })}
      </div></aside>
    </div>

    <details open>
      <summary>Todos los datos en tabla</summary>
      <TablaDemarcaciones completa />
    </details>
  </section>
</main>
<script>import '../components/map/mapa-gl.ts';</script>
<script is:inline>
(function () {
  var svg = document.getElementById('mapa'), panel = document.getElementById('panel');
  var paths = Array.prototype.slice.call(svg.querySelectorAll('path[data-c]'));
  var g = svg.querySelector('.resalte'), ext = g.querySelector('.ext'), inn = g.querySelector('.int');
  function resalta(p) { var d = p ? p.getAttribute('d') : ''; ext.setAttribute('d', d); inn.setAttribute('d', d); }
  function mostrar(cod) {
    Array.prototype.forEach.call(panel.children, function (x) { x.hidden = x.getAttribute('data-p') !== (cod || ''); });
  }
  var actual = null;
  function sel(p, foco) {
    paths.forEach(function (x) { x.setAttribute('aria-checked', 'false'); x.setAttribute('tabindex', '-1'); });
    p.setAttribute('aria-checked', 'true'); p.setAttribute('tabindex', '0'); actual = p;
    resalta(p); if (foco) p.focus();
    mostrar(p.getAttribute('data-c'));
  }
  svg.addEventListener('click', function (e) { if (e.target.getAttribute('role') === 'radio') sel(e.target); });
  svg.addEventListener('mouseover', function (e) { if (e.target.getAttribute('role') === 'radio') resalta(e.target); });
  svg.addEventListener('mouseout', function () { resalta(actual); });
  svg.addEventListener('focusin', function (e) { if (e.target.getAttribute('role') === 'radio') resalta(e.target); });
  svg.addEventListener('focusout', function () { resalta(actual); });
  svg.addEventListener('keydown', function (e) {
    var p = e.target; if (p.getAttribute('role') !== 'radio') return;
    var i = paths.indexOf(p), n = paths.length, k = e.key, j = -1;
    if (k === 'Enter' || k === ' ') { e.preventDefault(); sel(p); return; }
    if (k === 'ArrowRight' || k === 'ArrowDown') j = (i + 1) % n;
    else if (k === 'ArrowLeft' || k === 'ArrowUp') j = (i - 1 + n) % n;
    else if (k === 'Home') j = 0; else if (k === 'End') j = n - 1;
    if (j >= 0) { e.preventDefault(); sel(paths[j], true); }
  });
})();
</script>
<style is:global>
.mapa-caja { position: relative; --mar: #cfe3ee; }
@media (prefers-color-scheme: dark) { .mapa-caja { --mar: #0b1e30; } }
.mapa-gl { position: absolute; inset: 0; background: var(--mar); }
.mapa-gl:focus-visible { outline: var(--foco-anchura) solid var(--foco); outline-offset: calc(-1 * var(--foco-anchura)); }
.mapa-caja.gl-activo #mapa-svg { visibility: hidden; }
.mapa-ctl { position: absolute; top: var(--s-2); right: var(--s-2); display: flex; flex-direction: column; gap: var(--s-2); align-items: flex-end; z-index: 2; }
.mapa-ctl[hidden], .mapa-ctl button[hidden] { display: none; }
.mapa-ctl button { font: inherit; min-height: 2.75rem; padding: 0 var(--s-3); background: var(--fondo); color: var(--tinta); border: 2px solid var(--tinta); cursor: pointer; }
.mapa-ctl button:focus-visible { outline: var(--foco-anchura) solid var(--foco); outline-offset: var(--foco-offset); }
.solo-lector { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; margin: 0; }
.maplibregl-popup-content { background: var(--fondo); color: var(--tinta); font: inherit; padding: var(--s-3) var(--s-4); }
.maplibregl-popup-content p { margin: var(--s-1) 0; }
.maplibregl-popup-content a { color: var(--tinta); font-weight: var(--peso-negrita); }
.maplibregl-popup-anchor-top .maplibregl-popup-tip { border-bottom-color: var(--fondo); }
.maplibregl-popup-anchor-bottom .maplibregl-popup-tip { border-top-color: var(--fondo); }
.panel .todos-lista { max-height: 16rem; overflow: auto; }

.lay { display: grid; gap: var(--s-6); margin-top: var(--s-4); }
.lay .mapa { margin: 0; min-width: 0; }
.mapa path[role="radio"] { cursor: pointer; outline: none; }
/* Contorno doble: trazo exterior --tinta y trazo interior --fondo, ambos sobre el borde de la zona.
   Cada uno frente al otro 17,0:1 claro / 15,0:1 oscuro. Sobre cada relleno del agua, el mejor de los dos:
   claro (agua-0..5) fondo/tinta = 1,2/13,9; 3,1/5,4; 4,3/3,9; 6,3/2,7; 10,4/1,6; 16,5/1,0 -> minimo del mejor 3,9:1.
   oscuro = 1,6/9,4; 3,4/4,4; 5,0/3,0; 7,1/2,1; 10,6/1,4; 15,6/1,0 -> minimo del mejor 3,0:1. */
.mapa .resalte path { fill: none; pointer-events: none; stroke-linejoin: round; }
.mapa .resalte .ext { stroke: var(--tinta); stroke-width: 9; }
.mapa .resalte .int { stroke: var(--fondo); stroke-width: 4; }
.panel { border-top: var(--filete-grueso) solid var(--tinta); padding-top: var(--s-4); }
.panel h2 { font: var(--peso-titulo) var(--t-3)/var(--lh-titulo) var(--f-titulos); letter-spacing: -.02em; margin: 0 0 var(--s-3); }
.panel .nivel { display: flex; align-items: center; gap: var(--s-2); font-weight: var(--peso-negrita); margin: 0 0 var(--s-3); }
.panel .nivel .sw { width: var(--s-6); height: var(--s-4); }
.panel .gran { font: 700 var(--t-5)/var(--lh-apretado) var(--f-cifras); margin: 0 0 var(--s-3); }
.panel .gran mark { display: inline-block; line-height: var(--lh-apretado); }
.panel dl { margin: 0 0 var(--s-4); display: grid; grid-template-columns: auto 1fr; gap: var(--s-2) var(--s-4); }
.panel dt { color: var(--tinta-2); font-size: var(--t-0); }
.panel dd { margin: 0; text-align: right; }
.panel ul { margin: 0; padding-left: var(--s-5); }
.panel .vacio { color: var(--tinta-2); }
@media (min-width: 60rem) {
  .lay { grid-template-columns: minmax(0, 1fr) calc(var(--s-24) * 3.5); align-items: start; gap: var(--s-8); }
  .panel { position: sticky; top: var(--s-4); }
}
</style>
</Base>
