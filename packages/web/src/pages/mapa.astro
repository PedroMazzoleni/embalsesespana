---
import Base from '../layouts/Base.astro';
---
<Base title="¿Dónde hay agua? Mapa de embalses por demarcación" description="Mapa de la reserva de agua en cada demarcación hidrográfica peninsular, con tabla de datos." pag="mapa">
<main class="col ancha">
  <p class="fecha" id="fecha"></p>
  <section class="qa plena" aria-labelledby="q1">
    <h1 class="q" id="q1">¿dónde hay agua?</h1>
    <div class="a">
      <p class="si" id="si"></p>
      <p class="peq">Cada zona es una demarcación hidrográfica; el color dice cuánto de su capacidad está lleno. Elige una zona con el ratón, el dedo o el teclado (Tab y Enter) o usa las flechas para pasar de una a otra; Inicio y Fin van a la primera y a la última.</p>
    </div>

    <div class="lay">
      <figure class="mapa">
        <svg id="mapa" viewBox="0 0 1000 804" role="radiogroup" aria-labelledby="q1 mapa-d">
          <desc id="mapa-d">Mapa de la España peninsular por demarcación hidrográfica, coloreado según el porcentaje de llenado. Cada zona se puede seleccionar. Los valores exactos están en la tabla de debajo.</desc>
        </svg>
        <figcaption><ul class="leyenda" id="leyenda" aria-label="Leyenda: porcentaje de llenado"></ul>
        <p class="peq" id="nota-pts"></p></figcaption>
      </figure>
      <aside class="panel" aria-labelledby="p-t"><div id="panel" aria-live="polite"></div></aside>
    </div>

    <details open>
      <summary>Todos los datos en tabla</summary>
      <div class="tabla-w"><table id="tabla">
        <caption>Reserva de cada demarcación hidrográfica frente a la media de <span class="na"></span> años.</caption>
        <thead><tr><th scope="col">Demarcación</th><th scope="col">Nivel</th><th scope="col">Ahora</th><th scope="col">Volumen (hm³)</th><th scope="col">Capacidad (hm³)</th><th scope="col">Media <span class="na"></span> años</th></tr></thead>
        <tbody></tbody>
      </table></div>
    </details>
  </section>
</main>
<script is:inline slot="script" set:html={"(function () {\n  var U = window.U, M = U.M, f = U.f, set = U.set, svg = document.getElementById('mapa'), panel = document.getElementById('panel');\n  set('fecha', 'Boletín del ' + U.fecha + '. Datos provisionales.');\n  set('si', U.frase());\n  set('nota-pts', 'No se dibujan los embalses como puntos: la muestra de datos no trae latitud ni longitud. Llegarán con la tabla maestra.');\n  document.getElementById('leyenda').innerHTML = U.leyendaHTML();\n  svg.insertAdjacentHTML('beforeend', M.demarcaciones.map(function (d) {\n    var k = U.agua(d.pct);\n    return '<path class=\"c' + k + '\" data-c=\"' + d.codigo + '\" d=\"' + d.d + '\" tabindex=\"-1\" role=\"radio\" aria-checked=\"false\" aria-label=\"' + d.nombre + ': ' + f(d.pct) + ' %, nivel ' + U.nombres[k].toLowerCase() + '\"></path>';\n  }).join(''));\n  document.getElementById('tabla').tBodies[0].innerHTML = U.filas('nombre').map(function (d) {\n    var k = U.agua(d.pct);\n    return '<tr><th scope=\"row\">' + d.nombre + '</th><td><span class=\"sw c' + k + '\"></span>' + U.nombres[k] + '</td><td>' + f(d.pct) + ' %</td><td>' + f(d.hm3, 0) + '</td><td>' + f(d.capacidad, 0) + '</td><td>' + f(d.media10) + ' %</td></tr>';\n  }).join('');\n\n  function mostrar(cod) {\n    var d = M.demarcaciones.filter(function (x) { return x.codigo === cod; })[0];\n    if (!d) { panel.innerHTML = '<h2 id=\"p-t\">Elige una demarcación</h2><p class=\"vacio\">Aquí verás cuánta agua tiene, cómo está frente a su media y qué embalses de ejemplo hay.</p>'; return; }\n    var k = U.agua(d.pct), dif = d.pct - d.media10;\n    var rel = dif > 1 ? f(U.abs(dif)) + ' puntos por encima de su media de ' + U.NA + ' años.' : dif < -1 ? f(U.abs(dif)) + ' puntos por debajo de su media de ' + U.NA + ' años.' : 'En su media de ' + U.NA + ' años.';\n    var ej = M.ejemplos.filter(function (e) { return d.nombre.indexOf(e.demarcacion) === 0 || e.demarcacion.indexOf(d.nombre) === 0; });\n    panel.innerHTML = '<h2 id=\"p-t\">' + d.nombre + '</h2>' +\n      '<p class=\"nivel\"><span class=\"sw c' + k + '\"></span>' + U.nombres[k] + '</p>' +\n      '<p class=\"gran\"><mark>' + f(d.pct) + ' %</mark></p>' +\n      '<p>' + rel + '</p>' +\n      '<dl><dt>Volumen</dt><dd class=\"cifra\">' + f(d.hm3, 0) + ' hm³</dd><dt>Capacidad</dt><dd class=\"cifra\">' + f(d.capacidad, 0) + ' hm³</dd><dt>Media ' + U.NA + ' años</dt><dd class=\"cifra\">' + f(d.media10) + ' %</dd><dt>Embalses</dt><dd class=\"cifra\">' + f(d.embalses, 0) + '</dd></dl>' +\n      (ej.length ? '<p class=\"peq\">Embalses de ejemplo:</p><ul>' + ej.map(function (e) { return '<li><a href=\"/embalse/saucelle\">' + e.nombre + '</a>, <span class=\"cifra\">' + f(e.pct) + ' %</span></li>'; }).join('') + '</ul>' : '');\n  }\n  var NS = 'http://www.w3.org/2000/svg', gr = document.createElementNS(NS, 'g'), ext = document.createElementNS(NS, 'path'), inn = document.createElementNS(NS, 'path');\n  gr.setAttribute('class', 'resalte'); ext.setAttribute('class', 'ext'); inn.setAttribute('class', 'int'); gr.appendChild(ext); gr.appendChild(inn); svg.appendChild(gr);\n  function resalta(p) { var d = p ? p.getAttribute('d') : ''; ext.setAttribute('d', d); inn.setAttribute('d', d); }\n  // Orden del teclado: de norte a sur (y de oeste a este a igual altura), segun el centro de cada zona\n  var paths = Array.prototype.slice.call(svg.querySelectorAll('path[data-c]')).map(function (p) { var b = p.getBBox(); return { p: p, y: Math.round((b.y + b.height / 2) / 60), x: b.x + b.width / 2 }; })\n    .sort(function (a, b) { return a.y - b.y || a.x - b.x; }).map(function (o) { return o.p; });\n  paths.forEach(function (p) { svg.insertBefore(p, gr); });\n  var actual = null;\n  function sel(p, foco) {\n    paths.forEach(function (x) { x.setAttribute('aria-checked', 'false'); x.setAttribute('tabindex', '-1'); });\n    p.setAttribute('aria-checked', 'true'); p.setAttribute('tabindex', '0'); actual = p;\n    resalta(p); if (foco) p.focus();\n    mostrar(p.getAttribute('data-c'));\n  }\n  paths[0].setAttribute('tabindex', '0');\n  svg.addEventListener('click', function (e) { if (e.target.getAttribute('role') === 'radio') sel(e.target); });\n  svg.addEventListener('mouseover', function (e) { if (e.target.getAttribute('role') === 'radio') resalta(e.target); });\n  svg.addEventListener('mouseout', function () { resalta(actual); });\n  svg.addEventListener('focusin', function (e) { if (e.target.getAttribute('role') === 'radio') resalta(e.target); });\n  svg.addEventListener('focusout', function () { resalta(actual); });\n  svg.addEventListener('keydown', function (e) {\n    var p = e.target; if (p.getAttribute('role') !== 'radio') return;\n    var i = paths.indexOf(p), n = paths.length, k = e.key, j = -1;\n    if (k === 'Enter' || k === ' ') { e.preventDefault(); sel(p); return; }\n    if (k === 'ArrowRight' || k === 'ArrowDown') j = (i + 1) % n;\n    else if (k === 'ArrowLeft' || k === 'ArrowUp') j = (i - 1 + n) % n;\n    else if (k === 'Home') j = 0; else if (k === 'End') j = n - 1;\n    if (j >= 0) { e.preventDefault(); sel(paths[j], true); }\n  });\n  mostrar(null);\n})();\n"}></script>
<style is:global set:html={"\n.lay { display: grid; gap: var(--s-6); margin-top: var(--s-4); }\n.lay .mapa { margin: 0; min-width: 0; }\n.mapa path[role=\"radio\"] { cursor: pointer; outline: none; }\n/* Contorno doble: trazo exterior --tinta y trazo interior --fondo, ambos sobre el borde de la zona.\n   Cada uno frente al otro 17,0:1 claro / 15,0:1 oscuro. Sobre cada relleno del agua, el mejor de los dos:\n   claro (agua-0..5) fondo/tinta = 1,2/13,9; 3,1/5,4; 4,3/3,9; 6,3/2,7; 10,4/1,6; 16,5/1,0 -> minimo del mejor 3,9:1.\n   oscuro = 1,6/9,4; 3,4/4,4; 5,0/3,0; 7,1/2,1; 10,6/1,4; 15,6/1,0 -> minimo del mejor 3,0:1. */\n.mapa .resalte path { fill: none; pointer-events: none; stroke-linejoin: round; }\n.mapa .resalte .ext { stroke: var(--tinta); stroke-width: 9; }\n.mapa .resalte .int { stroke: var(--fondo); stroke-width: 4; }\n.panel { border-top: var(--filete-grueso) solid var(--tinta); padding-top: var(--s-4); }\n.panel h2 { font: var(--peso-titulo) var(--t-3)/var(--lh-titulo) var(--f-titulos); letter-spacing: -.02em; margin: 0 0 var(--s-3); }\n.panel .nivel { display: flex; align-items: center; gap: var(--s-2); font-weight: var(--peso-negrita); margin: 0 0 var(--s-3); }\n.panel .nivel .sw { width: var(--s-6); height: var(--s-4); }\n.panel .gran { font: 700 var(--t-5)/var(--lh-apretado) var(--f-cifras); margin: 0 0 var(--s-3); }\n.panel .gran mark { display: inline-block; line-height: var(--lh-apretado); }\n.panel dl { margin: 0 0 var(--s-4); display: grid; grid-template-columns: auto 1fr; gap: var(--s-2) var(--s-4); }\n.panel dt { color: var(--tinta-2); font-size: var(--t-0); }\n.panel dd { margin: 0; text-align: right; }\n.panel ul { margin: 0; padding-left: var(--s-5); }\n.panel .vacio { color: var(--tinta-2); }\n@media (min-width: 60rem) {\n  .lay { grid-template-columns: minmax(0, 1fr) calc(var(--s-24) * 3.5); align-items: start; gap: var(--s-8); }\n  .panel { position: sticky; top: var(--s-4); }\n}\n"}></style>
</Base>
