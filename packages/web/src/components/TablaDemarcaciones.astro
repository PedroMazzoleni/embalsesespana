---
import { porNombre, porPct, NA, NOMBRES, clase, f, slugCuenca } from '../lib/datos';
const { completa = false } = Astro.props;
const filas = completa ? porNombre : porPct;
---
<div class="tabla-w"><table>
  <caption>Reserva de cada demarcación frente a la media de {NA} años.</caption>
  <thead><tr><th scope="col">Demarcación</th><th scope="col">Nivel</th><th scope="col">Ahora</th>{completa && <><th scope="col">Volumen (hm³)</th><th scope="col">Capacidad (hm³)</th></>}<th scope="col">Media {NA} años</th></tr></thead>
  <tbody>
    {filas.map((d) => { const k = clase(d.pct); return (
      <tr><th scope="row"><a href={`/cuenca/${slugCuenca(d.nombre)}`}>{d.nombre}</a></th><td><span class={`sw c${k}`}></span>{NOMBRES[k]}</td><td>{f(d.pct)} %</td>{completa && <><td>{f(d.hm3, 0)}</td><td>{f(d.capacidad, 0)}</td></>}<td>{d.media10 == null ? 'sin dato' : `${f(d.media10)} %`}</td></tr>
    ); })}
  </tbody>
</table></div>
